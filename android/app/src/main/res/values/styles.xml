<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash durante il cold start su API 28-30: qui non esiste la
         SplashScreen API, quindi lo splash È la finestra di lancio e il
         marchio sta dentro `launch_background`. Su API 31+ questo stile è
         sostituito da `values-v31/styles.xml`, dove lo splash lo compone il
         sistema. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applicato quando Flutter è pronto: bg solido dark Koru. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/koru_background_base</item>
    </style>
</resources>
