<?xml version="1.0" encoding="utf-8"?>
<!-- Root del widget "tempo d'uso + limiti". Linguaggio Material 3 Expressive:
     superficie tonale ad angoli di sistema, metrica principale contenuta in
     una pill, tipografia Roboto Medium, niente divisori (in M3 la struttura la
     fa lo spazio, non le linee).

     Le righe NON sono dichiarate qui: vengono create a runtime da
     [com.dev.koru.widget.UsageWidgetRenderer] e appese a `widget_rows` con
     RemoteViews.addView, così il numero di righe si adatta all'altezza reale
     del widget (4x2 → 4x4) invece di essere fisso.

     `android:id="@android:id/background"` sul root è richiesto da Android 12+
     per far riconoscere al sistema lo sfondo del widget e applicargli la
     maschera degli angoli arrotondati.

     ATTENZIONE, vincolo che vale per TUTTI i layout del widget: RemoteViews
     inflata nel processo del launcher con un filtro che accetta solo le classi
     annotate @RemoteView. `android.view.View` NON lo è, quindi uno spaziatore
     o un divisore scritti come `<View>` farebbero fallire l'inflazione e il
     launcher mostrerebbe "Problem loading widget" al posto del contenuto —
     usa margini/padding, oppure ImageView (che è annotata). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_usage_background"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- Header: label "OGGI" + pill con il tempo totale della giornata. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/koru_widget_title"
            android:textColor="@color/koru_widget_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- `text` di default: questo layout è anche `previewLayout` nel picker
             dei widget e `initialLayout` prima del primo onUpdate. Senza un
             valore il totale apparirebbe vuoto e il widget sembrerebbe rotto;
             viene sostituito dal numero reale entro il primo render.

             Su @drawable/widget_total_pill (riempimento salvia) va l'on-color
             chiaro del container, non `koru_widget_text`. -->
        <TextView
            android:id="@+id/widget_header_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_total_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/koru_widget_placeholder_total"
            android:textColor="@color/koru_widget_on_pill"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <!-- Pill del contatore reel. `gone` di default: a zero reel (o con la
             feature spenta) non deve comparire affatto — un "0" perenne accanto
             al tempo d'uso è rumore, e questo layout è anche il previewLayout
             del picker dei widget, dove non c'è ancora nessun dato.

             Vive dentro l'header proprio per non costare altezza: le righe delle
             app sono dimensionate su HEADER_DP in UsageWidgetModel, e una riga
             dedicata avrebbe tolto un'app dal widget 4x2. -->
        <TextView
            android:id="@+id/widget_header_reels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_reels_pill"
            android:paddingStart="10dp"
            android:paddingEnd="11dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:drawableStart="@drawable/ic_widget_reels"
            android:drawablePadding="4dp"
            android:text="@string/koru_widget_reels_placeholder"
            android:textColor="@color/koru_widget_text_secondary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Contenitore delle righe dinamiche (vedi UsageWidgetRenderer).
         Il distacco dall'header è tutto in questo margine: vedi HEADER_DP in
         UsageWidgetModel, che lo conteggia. -->
    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <!-- Stato vuoto / errore: mostrato al posto delle righe.

         VISIBILE di default (non `gone`) con il testo dello stato vuoto: questo
         layout è anche `previewLayout` nel picker dei widget e `initialLayout`
         prima del primo render, dove `widget_rows` è per forza vuoto. Senza,
         il picker mostrerebbe una card con solo l'intestazione e un'area vuota.
         Il renderer imposta ESPLICITAMENTE la visibilità di questa view su
         ogni percorso (GONE quando ci sono righe, VISIBLE via `showMessage`),
         quindi il default non può sopravvivere a un render vero. -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/koru_widget_empty"
        android:textColor="@color/koru_widget_text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />
</LinearLayout>
