<?xml version="1.0" encoding="utf-8"?>
<!-- Pill del contatore reel, accanto a quella del tempo totale.

     Riempimento NEUTRO (`koru_widget_track`, la stessa superficie elevata delle
     barre) contro il salvia di `widget_total_pill`: due pill accese allo stesso
     modo competerebbero, e la metrica principale del widget resta il tempo
     d'uso. Stesso raggio pieno, così le due leggono come una coppia. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/koru_widget_track" />
    <corners android:radius="100dp" />
</shape>
