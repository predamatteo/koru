<?xml version="1.0" encoding="utf-8"?>
<!-- Barra used/cap oltre l'80% del limite (sabbia = KoruColors.tertiary).
     Vedi widget_progress_under.xml per la forma M3 (pill + stop indicator) e
     per il perché di tre drawable distinti. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/koru_widget_track" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
            <item
                android:width="6dp"
                android:height="6dp"
                android:gravity="right|center_vertical">
                <shape android:shape="oval">
                    <solid android:color="@color/koru_widget_sand" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/koru_widget_sand" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
