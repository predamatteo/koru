<?xml version="1.0" encoding="utf-8"?>
<!-- Barra used/cap RAGGIUNTO o superato (salmone = KoruColors.danger).
     Vedi widget_progress_under.xml per il perché di tre drawable distinti. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/koru_widget_track" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/koru_widget_danger" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
