        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3.6 L18.4,10 L17,11.4 L12,6.4 L7,11.4 L5.6,10 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,20.4 L5.6,14 L7,12.6 L12,17.6 L17,12.6 L18.4,14 Z" />
